<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Dashboard</title>

    <link rel="stylesheet" href="/css/style.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">

    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body>

    <%- include("partials/navbar") %>

    <div class="container py-5">

        <%- include("partials/alerts") %>

        <!-- Hero Banner -->
        <div class="hero-banner p-5 shadow-lg mb-5">

            <h1 class="fw-bold">
                Welcome, <%= user.username %> 👋
            </h1>

            <p class="fs-5 mt-3 mb-2">
                Manage your E-Commerce Platform easily.
            </p>

            <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                <i class="bi bi-person-badge"></i>
                <%= user.role.toUpperCase() %>
            </span>

        </div>

        <!-- Dashboard Cards -->
        <div class="row g-4">

            <div class="col-lg-3 col-md-6">

                <div class="card dashboard-card text-center h-100 shadow">

                    <div class="card-body py-5">

                        <i class="bi bi-box-seam display-3 text-primary"></i>

                        <h1 class="fw-bold mt-3">
                            <%= totalProducts || 0 %>
                        </h1>

                        <p class="text-muted mb-0">
                            Total Products
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card dashboard-card text-center h-100 shadow">

                    <div class="card-body py-5">

                        <i class="bi bi-tags display-3 text-success"></i>

                        <h1 class="fw-bold mt-3">
                            <%= totalCategories || 0 %>
                        </h1>

                        <p class="text-muted mb-0">
                            Total Categories
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card dashboard-card text-center h-100 shadow">

                    <div class="card-body py-5">

                        <i class="bi bi-person-circle display-3 text-warning"></i>

                        <h4 class="fw-bold mt-3">

                            <%= user.username %>

                        </h4>

                        <span class="badge bg-primary px-3 py-2">

                            <%= user.role %>

                        </span>

                        <p class="text-muted mt-3 mb-0">
                            Logged In User
                        </p>

                    </div>

                </div>

            </div>

            <div class="col-lg-3 col-md-6">

                <div class="card dashboard-card text-center h-100 shadow">

                    <div class="card-body py-5">

                        <i class="bi bi-cart-check display-3 text-danger"></i>

                        <h1 class="fw-bold mt-3">

                            <%= myProducts || 0 %>

                        </h1>

                        <p class="text-muted mb-0">
                            My Products
                        </p>

                    </div>

                </div>

            </div>

        </div>

        <!-- Quick Actions -->

        <div class="mt-5">

            <h2 class="fw-bold mb-4">

                <i class="bi bi-lightning-charge-fill text-warning"></i>

                Quick Actions

            </h2>

            <div class="d-flex flex-wrap gap-3">

                <a href="/products" class="btn btn-primary quick-btn">

                    <i class="bi bi-box-seam"></i>

                    Products

                </a>

                <% if(user.role==="admin"){ %>

                <a href="/product/add" class="btn btn-success quick-btn">

                    <i class="bi bi-plus-circle"></i>

                    Add Product

                </a>

                <a href="/categories" class="btn btn-warning quick-btn">

                    <i class="bi bi-tags"></i>

                    Categories

                </a>

                <% } %>

                <a href="/my-products" class="btn btn-info quick-btn">

                    <i class="bi bi-cart-check"></i>

                    My Products

                </a>

            </div>

        </div>

    </div>

    <%- include("partials/footer") %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"></script>

</body>

</html>