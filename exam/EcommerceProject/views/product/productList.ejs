<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <title>All Products</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.css" rel="stylesheet">

</head>

<body style="background:#f8f9fa;">

    <%- include("../partials/navbar") %>

        <div class="container py-5">

            <%- include("../partials/alerts") %>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <h2>
                        <i class="bi bi-box-seam"></i>
                        All Products
                    </h2>


                    <% if(user.role==="admin" ){ %>

                        <a href="/product/add" class="btn btn-primary">

                            <i class="bi bi-plus-circle"></i>

                            Add Product

                        </a>

                        <% } %>

                </div>

                <form method="GET" action="/products" class="mb-4">

                    <div class="row">

                        <div class="col-md-4">

                            <select name="category" class="form-select" onchange="this.form.submit()">

                                <option value="">
                                    All Categories
                                </option>

                                <% categories.forEach(category=> { %>

                                    <option value="<%= category._id %>" <%=selectedCategory==category._id.toString()
                                        ? "selected" : "" %>>

                                        <%= category.name %>

                                    </option>

                                    <% }) %>

                            </select>

                        </div>

                    </div>

                </form>

                <div class="row">

                    <% if(products.length===0){ %>

                        <div class="text-center py-5">

                            <i class="bi bi-box-seam display-1 text-secondary"></i>

                            <h3 class="mt-3">
                                No Products Available
                            </h3>

                            <p class="text-muted">
                                Click below to add your first product.
                            </p>

                            <% if(user.role==="admin" ){ %>

                                <a href="/product/add" class="btn btn-primary rounded-pill px-4">
                                    <i class="bi bi-plus-circle"></i>
                                    Add Product
                                </a>

                                <% } %>

                        </div>

                        <% } else { %>

                            <% products.forEach(product=> { %>

                                <div class="col-lg-4 col-md-6 mb-4">

                                    <%- include("productItem", { product: product }) %>

                                </div>

                                <% }) %>

                                    <% } %>

                </div>

        </div>

        <%- include("../partials/footer") %>

</body>

</html>